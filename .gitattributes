# Auto-detect text files and normalize line endings to LF on commit
* text=auto eol=lf

# Explicitly declare binary file types (no CRLF conversion)
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.webp binary
*.svg  binary
*.woff binary
*.woff2 binary
*.ttf  binary
*.otf  binary
*.eot  binary
*.glb  binary
*.gltf binary
*.hdr  binary
*.wasm binary
*.enc  binary
